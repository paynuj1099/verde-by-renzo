rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.admin == true;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /siteAssets/{assetId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /guestOrders/{reference} {
      allow create: if isAdmin() || (
        request.resource.data.status == 'pre-order' &&
        request.resource.data.reference == reference &&
        request.resource.data.keys().hasOnly([
          'reference',
          'customer',
          'items',
          'totalItems',
          'totalAmount',
          'status',
          'createdAt'
        ])
      );

      allow get: if true;
      allow list, update: if isAdmin();
      allow delete: if false;
    }

    match /users/{userId} {

      /*
       * CUSTOMER
       * Can create only their own profile and cannot
       * assign themselves a role.
       */
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        !request.resource.data.keys().hasAny([
          'role'
        ]);

      /*
       * READ
       *
       * Normal customer:
       *   Can only read their own profile.
       *
       * Admin:
       *   Can read any user and list all users.
       */
      allow read: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId
      );

      /*
       * UPDATE
       *
       * Admin can update any user's Firestore profile.
       *
       * Normal customers can update their own allowed
       * profile fields only.
       */
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'email',
            'photoURL',
            'phone',
            'provider',
            'lastLoginAt'
          ])
      );

      /*
       * Prevent client-side deletion of user profiles.
       */
      allow delete: if false;

      /*
       * User-owned nested documents.
       */
      match /{document=**} {
        allow read, write: if isAdmin() || (
          isSignedIn() &&
          request.auth.uid == userId
        );
      }

      /*
       * User Orders
       */
      match /orders/{orderId} {
        allow read, create: if isAdmin() || (
          isSignedIn() &&
          request.auth.uid == userId
        );

        allow update: if isAdmin() || (
          isSignedIn() &&
          request.auth.uid == userId
        );

        allow delete: if isSignedIn() &&
          request.auth.uid == userId;
      }
    }

    /*
     * Allows the admin Orders page to query orders
     * across all users using a collectionGroup query.
     */
    match /{path=**}/orders/{orderId} {
      allow read, update: if isAdmin();
    }
  }
}