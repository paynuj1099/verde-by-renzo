# ============================================
# Environment Variables
# ============================================

# --------------------------------------------
# Web3Forms
# --------------------------------------------
# Used for contact form submissions.
# Get your access key from:
# https://web3forms.com/
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key


# --------------------------------------------
# Firebase Web App Configuration
# --------------------------------------------
# Get these values from:
# Firebase Console > Project Settings > General > Your apps > Web app
#
# These NEXT_PUBLIC_* values are exposed to the browser.
# Firebase security should be enforced using Authentication,
# Firestore Security Rules, and server-side authorization.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyEXAMPLE123456789
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-EXAMPLE123


# --------------------------------------------
# Firebase Admin SDK
# --------------------------------------------
# Used only on the server for privileged Firebase operations,
# including verifying authentication tokens and checking/administering
# custom claims such as the admin role.
#
# Get these values from:
# Firebase Console > Project Settings > Service Accounts
#
# NEVER expose these using NEXT_PUBLIC_*.
# NEVER commit actual credentials to GitHub.

FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-example@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"


# --------------------------------------------
# ImageKit
# --------------------------------------------
# Used for product images, uploads, optimization,
# and image delivery.
#
# Get these values from:
# ImageKit Dashboard > Developer options
#
# Public URL endpoint and public key can be used by
# client-side functionality when required.
# Keep IMAGEKIT_PRIVATE_KEY server-side only.

NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/verdebyrenzo
IMAGEKIT_PUBLIC_KEY=public_example123456789
IMAGEKIT_PRIVATE_KEY=private_example123456789


# --------------------------------------------
# PayMongo
# --------------------------------------------
# Used for payment processing through PayMongo.
#
# Get these values from:
# PayMongo Dashboard > Developers > API Keys
#
# PAYMONGO_SECRET_KEY must remain server-side.
# Never expose or commit your real secret key.

PAYMONGO_SECRET_KEY=sk_test_example123456789
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_example123456789


# --------------------------------------------
# Application URL
# --------------------------------------------
# Base URL used for redirects after PayMongo checkout,
# payment success/cancel routes, and other absolute URLs.
#
# Development:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Production example:
NEXT_PUBLIC_SITE_URL=https://verde-by-renzo.vercel.app